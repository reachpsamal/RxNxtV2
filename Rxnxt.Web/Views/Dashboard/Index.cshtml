@model Rxnxt.Services.Dtos.DashboardData
@{
    ViewData["Title"] = "Dashboard";
    string Fmt(decimal v) => v.ToString("N2");
    string FmtQty(decimal v) => v.ToString("N0");
}

<div class="dashboard-page">
    <div class="section-card">
        <div class="section-header">
            <div class="section-title">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </div>
            <span class="section-badge info">@DateTime.Today.ToString("dd MMM yyyy")</span>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="dashboard-card teal">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">₹ @Fmt(Model.TodaySaleAmount)</div>
                    <div class="dashboard-card-label">Today's Sale</div>
                </div>
            </div>
            <div class="dashboard-card-sub">@Model.TodaySaleBills bills</div>
        </div>

        <div class="dashboard-card blue">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">@FmtQty(Model.OpdSalesCount)</div>
                    <div class="dashboard-card-label">OPD Sales</div>
                </div>
            </div>
            <div class="dashboard-card-sub">patient prescriptions</div>
        </div>

        <div class="dashboard-card green">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-cart"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">@FmtQty(Model.DirectSalesCount)</div>
                    <div class="dashboard-card-label">Direct Sales</div>
                </div>
            </div>
            <div class="dashboard-card-sub">walk-in customers</div>
        </div>

        <div class="dashboard-card orange">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-bag-check"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">₹ @Fmt(Model.TodayPurchaseAmount)</div>
                    <div class="dashboard-card-label">Today's Purchase</div>
                </div>
            </div>
            <div class="dashboard-card-sub">@Model.TodayPurchaseBills bills</div>
        </div>

        <div class="dashboard-card red">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-arrow-return-left"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">₹ @Fmt(Model.TodayReturnAmount)</div>
                    <div class="dashboard-card-label">Sale Return</div>
                </div>
            </div>
            <div class="dashboard-card-sub">@Model.TodayReturnBills returns</div>
        </div>

        <div class="dashboard-card amber">
            <div class="dashboard-card-row">
                <div class="dashboard-card-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="dashboard-card-body">
                    <div class="dashboard-card-value">@FmtQty(Model.NearExpiryCount)</div>
                    <div class="dashboard-card-label">Near Expiry Items</div>
                </div>
            </div>
            <div class="dashboard-card-sub">expiring within 3 months</div>
        </div>
    </div>

    <div class="section-card" style="margin-top:24px;">
        <div class="section-header">
            <div class="section-title">
                <i class="bi bi-bar-chart-line"></i>
                Top 20 Moving Items (Today)
            </div>
            <span class="section-badge info">@Model.Top20Items.Count items</span>
        </div>
        <div class="dashboard-table-wrapper">
            <table class="dashboard-top-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product Name</th>
                        <th>Batch</th>
                        <th class="text-end">Qty Sold</th>
                        <th class="text-end">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Top20Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-3">No data available</td>
                        </tr>
                    }
                    @foreach (var item in Model.Top20Items)
                    {
                        <tr>
                            <td class="rank">@item.Rank</td>
                            <td class="product">@item.ProductName</td>
                            <td class="batch">@item.Batch</td>
                            <td class="text-end">@FmtQty(item.QtySold)</td>
                            <td class="text-end amount">@Fmt(item.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
