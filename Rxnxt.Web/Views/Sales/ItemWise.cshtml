@model Rxnxt.Web.ViewModels.ItemWiseReportViewModel
@{
    ViewData["Title"] = "Item-wise Sale Report";
    string Fmt(decimal v) => v.ToString("0.00");
    string FmtQty(decimal v) => v.ToString("0.##");
}

<div class="stock-report-page">
    <div class="section-card">
        <div class="section-header">
            <div class="section-title">
                <i class="bi bi-box-seam"></i>
                Item-wise Sale Report
            </div>
            <span class="section-badge info">@Model.Rows.Count items</span>
        </div>
    </div>

    <div class="section-card" style="margin-top:16px; overflow:visible;">
        <div class="section-header">
            <div class="section-title">
                <i class="bi bi-funnel"></i>
                Filters
            </div>
            <a class="btn-ghost" href="@Url.Action("ItemWise", "Sales")">
                <i class="bi bi-x-circle"></i> Clear
            </a>
        </div>
        <div class="section-body">
            <form method="get" asp-action="ItemWise" asp-controller="Sales">
                <div class="stock-filter-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr;">
                    <div>
                        <label class="form-label-custom">From</label>
                        <input type="date" class="pharmacy-input" name="From" value="@Model.Filter.From.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="form-label-custom">To</label>
                        <input type="date" class="pharmacy-input" name="To" value="@Model.Filter.To.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="form-label-custom">Manufacturer</label>
                        <input type="text" class="pharmacy-input" name="Manufacturer" value="@Model.Filter.Manufacturer" placeholder="Search manufacturer..." />
                    </div>
                    <div>
                        <label class="form-label-custom">Batch</label>
                        <input type="text" class="pharmacy-input" name="Batch" value="@Model.Filter.Batch" placeholder="Search batch..." />
                    </div>
                </div>
                <div class="stock-filter-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr; margin-top:10px;">
                    <div>
                        <label class="form-label-custom">Expiry From</label>
                        <input type="date" class="pharmacy-input" name="ExpiryFrom" value="@Model.Filter.ExpiryFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="form-label-custom">Expiry To</label>
                        <input type="date" class="pharmacy-input" name="ExpiryTo" value="@Model.Filter.ExpiryTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="form-label-custom">Movement Type</label>
                        <select class="pharmacy-input" name="MovementType">
                            <option value="All" selected="@(Model.Filter.MovementType == "All" || Model.Filter.MovementType == null)">All</option>
                            <option value="Fast" selected="@(Model.Filter.MovementType == "Fast")">Fast</option>
                            <option value="Slow" selected="@(Model.Filter.MovementType == "Slow")">Slow</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label-custom">Movement Threshold (Qty)</label>
                        <input type="number" class="pharmacy-input" name="MovementThreshold" value="@(Model.Filter.MovementThreshold ?? 10)" step="1" min="0" />
                    </div>
                </div>
                <div class="stock-filter-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr; margin-top:10px;">
                    <div>
                        <label class="form-label-custom">Store</label>
                        <select class="pharmacy-input" name="StoreId">
                            <option value="">All</option>
                            @foreach (var s in Model.Filter.StoreOptions)
                            {
                                <option value="@s" selected="@(Model.Filter.StoreId == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label-custom">User</label>
                        <select class="pharmacy-input" name="CreatedBy">
                            <option value="">All</option>
                            @foreach (var u in Model.Filter.UserOptions)
                            {
                                <option value="@u" selected="@(Model.Filter.CreatedBy == u)">@u</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label-custom">Bill Status</label>
                        <select class="pharmacy-input" name="BillStatus">
                            <option value="All" selected="@(Model.Filter.BillStatus == "All")">All</option>
                            <option value="Completed" selected="@(Model.Filter.BillStatus == "Completed")">Completed</option>
                            <option value="Cancelled" selected="@(Model.Filter.BillStatus == "Cancelled")">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="stock-filter-grid" style="margin-top:10px; grid-template-columns: 1fr;">
                    <div class="stock-filter-action" style="gap:6px; display:flex;">
                        <button class="btn-primary-pharmacy" type="submit">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <div class="dropdown-wrap">
                            <button class="btn-secondary-pharmacy dropdown-trigger" type="button" onclick="this.nextElementSibling.classList.toggle('open')">
                                <i class="bi bi-download"></i> Download <i class="bi bi-chevron-down" style="font-size:10px;"></i>
                            </button>
                            <div class="dropdown-menu">
                                <button class="dropdown-item" type="submit" formaction="@Url.Action("ItemWiseExcel")">
                                    <i class="bi bi-file-earmark-excel"></i> Excel
                                </button>
                                <button class="dropdown-item" type="submit" formaction="@Url.Action("ItemWisePdf")">
                                    <i class="bi bi-file-earmark-pdf"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Rows.Count > 0)
    {
        <div class="section-card" style="margin-top:16px;">
            <div class="section-header">
                <div class="section-title">
                    <i class="bi bi-graph-up"></i>
                    Analytics
                </div>
            </div>
            <div class="section-body">
                <div class="stock-summary-grid" style="grid-template-columns: repeat(3, 1fr);">
                    <div class="stock-summary-tile success" onclick="showAnalyticsDetail('top20-detail')" style="cursor:pointer;">
                        <span class="tile-label">Top 20 Items</span>
                        <span class="tile-value">@Model.Top20.Select(r => r.ItemCode).Distinct().Count()</span>
                    </div>
                    <div class="stock-summary-tile warning" onclick="showAnalyticsDetail('deadstock-detail')" style="cursor:pointer;">
                        <span class="tile-label">Dead Stock</span>
                        <span class="tile-value">@Model.DeadStockItems.Count</span>
                    </div>
                    <div class="stock-summary-tile" style="background:#fef3c7;cursor:pointer;" onclick="showAnalyticsDetail('nearexpiry-detail')">
                        <span class="tile-label">Near Expiry Sales</span>
                        <span class="tile-value">@Model.NearExpiryCount</span>
                    </div>
                </div>

                <div id="top20-detail" class="analytics-detail" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <strong style="font-size:14px;">Top 20 Items (by Qty Sold)</strong>
                        <button type="button" onclick="document.getElementById('top20-detail').style.display='none'" style="background:none;border:none;font-size:18px;cursor:pointer;">&times;</button>
                    </div>
                    <div class="stock-table-wrap">
                        <table class="stock-report-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Item Name</th>
                                    <th>Batch</th>
                                    <th>Expiry</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Cost</th>
                                    <th class="text-right">Sale Value</th>
                                    <th class="text-right">Profit</th>
                                    <th class="text-right">Margin%</th>
                                    <th class="text-right">Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Top20)
                                {
                                    <tr>
                                        <td><strong>@r.ItemCode</strong></td>
                                        <td>@r.ItemName</td>
                                        <td>@r.Batch</td>
                                        <td>@r.Expiry</td>
                                        <td class="text-right">@FmtQty(r.QtySold)</td>
                                        <td class="text-right">@Fmt(r.PurchaseCost)</td>
                                        <td class="text-right">@Fmt(r.SaleValue)</td>
                                        <td class="text-right">@Fmt(r.Profit)</td>
                                        <td class="text-right">@r.MarginPerc.ToString("0.00")%</td>
                                        <td class="text-right">@FmtQty(r.CurrentStock)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="deadstock-detail" class="analytics-detail" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <strong style="font-size:14px;">Dead Stock (in stock, zero sales)</strong>
                        <button type="button" onclick="document.getElementById('deadstock-detail').style.display='none'" style="background:none;border:none;font-size:18px;cursor:pointer;">&times;</button>
                    </div>
                    <div class="stock-table-wrap">
                        <table class="stock-report-table">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Item Name</th>
                                    <th>Manufacturer</th>
                                    <th>Batch</th>
                                    <th>Expiry</th>
                                    <th class="text-right">Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.DeadStockItems)
                                {
                                    <tr>
                                        <td><strong>@r.ItemCode</strong></td>
                                        <td>@r.ItemName</td>
                                        <td>@r.Manufacturer</td>
                                        <td>@r.Batch</td>
                                        <td>@r.Expiry</td>
                                        <td class="text-right">@FmtQty(r.CurrentStock)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div id="nearexpiry-detail" class="analytics-detail" style="display:none;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                        <strong style="font-size:14px;">Near Expiry Sales (sold within 3 months of expiry)</strong>
                        <button type="button" onclick="document.getElementById('nearexpiry-detail').style.display='none'" style="background:none;border:none;font-size:18px;cursor:pointer;">&times;</button>
                    </div>
                    @if (Model.NearExpiryItems.Count == 0)
                    {
                        <div class="stock-empty-state" style="padding:16px;">
                            <i class="bi bi-inboxes"></i>
                            <p>No near expiry sales found</p>
                        </div>
                    }
                    else
                    {
                        <div class="stock-table-wrap">
                            <table class="stock-report-table">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Item Name</th>
                                        <th>Batch</th>
                                        <th>Expiry</th>
                                        <th class="text-right">Qty</th>
                                        <th class="text-right">Sale Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.NearExpiryItems)
                                    {
                                        <tr>
                                            <td><strong>@r.ItemCode</strong></td>
                                            <td>@r.ItemName</td>
                                            <td>@r.Batch</td>
                                            <td>@r.Expiry</td>
                                            <td class="text-right">@FmtQty(r.QtySold)</td>
                                            <td class="text-right">@Fmt(r.SaleValue)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="section-card" style="margin-top:16px;">
        <div class="section-header">
            <div class="section-title">
                <i class="bi bi-table"></i>
                Item-wise Details
            </div>
        </div>
        <div class="section-body">
            @if (Model.Rows.Count == 0)
            {
                <div class="empty-cart stock-empty-state">
                    <i class="bi bi-inboxes"></i>
                    <p>No data found</p>
                    <span>Adjust filters to view item-wise data.</span>
                </div>
            }
            else
            {
                <div class="stock-table-wrap">
                    <table class="stock-report-table">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Item Name</th>
                                <th>Manufacturer</th>
                                <th>Batch</th>
                                <th>Expiry</th>
                                <th class="text-right">Qty</th>
                                <th class="text-right">Free</th>
                                <th class="text-right">Cost</th>
                                <th class="text-right">Sale Value</th>
                                <th class="text-right">Profit</th>
                                <th class="text-right">Margin%</th>
                                <th class="text-right">Stock</th>
                                <th class="text-right">Rate</th>
                                <th class="text-right">MRP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                decimal tQty = 0, tFree = 0, tCost = 0, tSale = 0, tProfit = 0;
                            }
                            @foreach (var r in Model.Rows)
                            {
                                tQty += r.QtySold;
                                tFree += r.FreeQty;
                                tCost += r.PurchaseCost;
                                tSale += r.SaleValue;
                                tProfit += r.Profit;
                                <tr>
                                    <td><strong>@r.ItemCode</strong></td>
                                    <td>@r.ItemName</td>
                                    <td>@r.Manufacturer</td>
                                    <td>@r.Batch</td>
                                    <td>@r.Expiry</td>
                                    <td class="text-right">@FmtQty(r.QtySold)</td>
                                    <td class="text-right">@FmtQty(r.FreeQty)</td>
                                    <td class="text-right">@Fmt(r.PurchaseCost)</td>
                                    <td class="text-right">@Fmt(r.SaleValue)</td>
                                    <td class="text-right">@Fmt(r.Profit)</td>
                                    <td class="text-right">@r.MarginPerc.ToString("0.00")%</td>
                                    <td class="text-right">@FmtQty(r.CurrentStock)</td>
                                    <td class="text-right">@Fmt(r.SalePrice)</td>
                                    <td class="text-right">@Fmt(r.MRP)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5"><strong>Totals</strong></td>
                                <td class="text-right"><strong>@FmtQty(tQty)</strong></td>
                                <td class="text-right"><strong>@FmtQty(tFree)</strong></td>
                                <td class="text-right"><strong>@Fmt(tCost)</strong></td>
                                <td class="text-right"><strong>@Fmt(tSale)</strong></td>
                                <td class="text-right"><strong>@Fmt(tProfit)</strong></td>
                                <td class="text-right"><strong>@(tSale > 0 ? (tProfit / tSale * 100).ToString("0.00") : "0.00")%</strong></td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.dropdown-wrap')) {
            document.querySelectorAll('.dropdown-menu.open').forEach(function (m) {
                m.classList.remove('open');
            });
        }
    });

    function showAnalyticsDetail(id) {
        var target = document.getElementById(id);
        if (!target) return;
        var isHidden = target.style.display === 'none' || target.style.display === '';
        document.querySelectorAll('.analytics-detail').forEach(function (el) {
            el.style.display = 'none';
        });
        target.style.display = isHidden ? 'block' : 'none';
    }
</script>
