@model Rxnxt.Domain.Models.Sale
@using System.Linq

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Print - @(Model?.InvoiceNumber ?? string.Empty)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        @@page { size: A4; margin: 8mm; }
        body { padding: 0; font-family: Arial, sans-serif; }
        .muted { color: #666; }
        hr {
  margin: 6px 0;         /* change as you need */
  opacity: 1;
  border-top: 1px solid #000;
}
        .mono { font-variant-numeric: tabular-nums; }
        .page { display: flex; flex-direction: column; min-height: calc(297mm - 16mm); }
        .copy-half { flex: 1 1 0; overflow: hidden; padding: 0; }
        .copy-full { padding: 0; }
        .copy-label { font-size: 12px; font-weight: 700; letter-spacing: 0.4px; }
        .hdr-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; position: relative; }
        .hdr-left h3 { margin: 0; font-size: 18px; }
        .hdr-left .muted { font-size: 12px; line-height: 1.2; }
        .hdr-row div { font-size: 12px; line-height: 1.25; }
        .hdr-grid { display: inline-grid; grid-template-columns: 1fr 260px; gap: 2px 12px; max-width: 560px; width: 100%; }
        .hdr-cell-right { text-align: left; }
        .copy-label-float { position: absolute; right: 0; top: 0; text-align: right; }
        .hdr-row strong { font-weight: 700; }
        .summary-row { display: flex; gap: 12px; justify-content: space-between; align-items: flex-start; }
        .tax-breakup { flex: 1 1 auto; max-width: 55%; }
        .tax-breakup table { width: 100%; border-collapse: collapse; }
        .tax-breakup th, .tax-breakup td { padding: 1px 4px; border: 1px solid #ddd; }
        .tax-breakup th { font-weight: 700; }
        .tax-breakup .lbl { width: 56px; }
        .tax-breakup .num { text-align: right; white-space: nowrap; }
        .pay-block { font-size: 9px; line-height: 1.2; }
        .cut-line { border-top: 1px dashed #000; margin: 6mm 0; }
        .page-break { break-before: page; page-break-before: always; }
        .hdr-row, .summary-row { break-inside: avoid; page-break-inside: avoid; }
        .table-sm > :not(caption) > * > * { padding: 0.15rem 0.25rem; }
        .table thead th { font-size: 10px; }
        .table tbody td { font-size: 8px; }
        .summary-row div, .summary-row span {
            font-size: 10px;
            line-height: 1.2;
            }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body>
    <div class="no-print" style="margin-bottom:16px; display:flex; gap:8px;">
        <button class="btn btn-primary" onclick="window.print()">Print</button>
        <button class="btn btn-outline-secondary" onclick="window.close()">Close</button>
    </div>

    @{
        const int maxRowsPerHalfPage = 15;
        var useTwoCopiesOnOnePage = (Model?.SaleItems?.Count ?? 0) <= maxRowsPerHalfPage;
        var paymentModes = (Model?.Payments ?? Enumerable.Empty<Rxnxt.Domain.Models.Payment>())
            .Select(p => (p?.PaymentMode ?? string.Empty).Trim())
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var paymentModeText = paymentModes.Count == 0 ? "-" : string.Join("+", paymentModes);

        static decimal IncludedTax(decimal taxInclusiveTotal, decimal rate) => rate > 0 ? (taxInclusiveTotal * (rate / (100m + rate))) : 0m;

        var saleItemsForCalc = (Model?.SaleItems ?? Enumerable.Empty<Rxnxt.Domain.Models.SaleItem>()).ToList();
        var itemDiscountAmt = saleItemsForCalc.Sum(i => i.DiscountAmount);
        var additionalDiscountAmt = Model?.AdditionalDiscount ?? 0m;

        var lineTotalSum = saleItemsForCalc.Sum(i => Math.Max(0m, (i.Price * i.Quantity) - i.DiscountAmount));
        var taxAmt = saleItemsForCalc.Sum(i => IncludedTax(Math.Max(0m, (i.Price * i.Quantity) - i.DiscountAmount), i.TaxPercent));
        var taxableAmt = lineTotalSum - taxAmt;

        var netGrandTotal = Math.Max(0m, lineTotalSum - additionalDiscountAmt);
        var roundedGrandTotal = Math.Round(netGrandTotal, 0, MidpointRounding.AwayFromZero);
        var roundOffAmt = roundedGrandTotal - netGrandTotal;

        string NumberToWords(long number)
        {
            if (number == 0) return "Zero";
            if (number < 0) return "Minus " + NumberToWords(Math.Abs(number));

            string ConvertBelowThousand(long n)
            {
                var ones = new[] { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
                var tens = new[] { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

                var parts = new List<string>();

                if (n >= 100)
                {
                    parts.Add(ones[n / 100] + " Hundred");
                    n %= 100;
                }

                if (n >= 20)
                {
                    parts.Add(tens[n / 10] + (n % 10 != 0 ? " " + ones[n % 10] : ""));
                }
                else if (n > 0)
                {
                    parts.Add(ones[n]);
                }

                return string.Join(" ", parts.Where(p => !string.IsNullOrWhiteSpace(p)));
            }

            var resultParts = new List<string>();

            void AddPart(long value, string label)
            {
                if (value <= 0) return;
                resultParts.Add(ConvertBelowThousand(value) + " " + label);
            }

            var crores = number / 10000000;
            number %= 10000000;
            var lakhs = number / 100000;
            number %= 100000;
            var thousands = number / 1000;
            number %= 1000;
            var remainder = number;

            AddPart(crores, "Crore");
            AddPart(lakhs, "Lakh");
            AddPart(thousands, "Thousand");
            if (remainder > 0)
            {
                resultParts.Add(ConvertBelowThousand(remainder));
            }

            return string.Join(" ", resultParts.Where(p => !string.IsNullOrWhiteSpace(p))).Trim();
        }

        var amountInWordsWords = NumberToWords((long)roundedGrandTotal);

        var taxByRate = saleItemsForCalc
            .GroupBy(i => i.TaxPercent)
            .Select(g => new
            {
                Rate = g.Key,
                TaxTotal = g.Sum(x => IncludedTax(Math.Max(0m, (x.Price * x.Quantity) - x.DiscountAmount), x.TaxPercent))
            })
            .Where(x => x.Rate > 0)
            .OrderBy(x => x.Rate)
            .ToList();

        var fixedRates = new[] { 5m, 12m, 18m };
        var taxTotalByRate = taxByRate.ToDictionary(x => x.Rate, x => x.TaxTotal);

        var paymentsOrdered = (Model?.Payments ?? Enumerable.Empty<Rxnxt.Domain.Models.Payment>())
            .Where(p => p != null && p.Amount != 0m)
            .Select(p =>
            {
                var rawMode = (p!.PaymentMode ?? string.Empty).Trim();
                var rawModeLower = rawMode.ToLowerInvariant();

                var displayMode = rawMode;
                var order = 99;
                if (rawModeLower.Contains("cash")) { displayMode = "Cash"; order = 0; }
                else if (rawModeLower.Contains("card")) { displayMode = "Card"; order = 1; }
                else if (rawModeLower.Contains("upi")) { displayMode = "UPI"; order = 2; }
                else if (string.IsNullOrWhiteSpace(displayMode)) { displayMode = "Payment"; }

                return new
                {
                    Order = order,
                    Mode = displayMode,
                    Amount = p.Amount,
                    Reference = (p.Reference ?? string.Empty).Trim()
                };
            })
            .ToList();

        var paymentsText = string.Join(", ", paymentsOrdered
            .GroupBy(x => x.Mode, StringComparer.OrdinalIgnoreCase)
            .Select(g => new
            {
                Mode = g.Key,
                Order = g.Min(x => x.Order),
                Amount = g.Sum(x => x.Amount),
                References = g.Select(x => x.Reference).Where(r => !string.IsNullOrWhiteSpace(r)).Distinct(StringComparer.OrdinalIgnoreCase).ToList()
            })
            .OrderBy(x => x.Order)
            .ThenBy(x => x.Mode)
            .Select(x =>
            {
                var amountText = $"₹ {x.Amount:0.00}";
                var referenceText = x.References.Count == 0 ? string.Empty : $" ({string.Join("/", x.References)})";
                return $"{x.Mode} {amountText}{referenceText}";
            }));
    }

