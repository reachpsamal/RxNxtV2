@model Rxnxt.Web.ViewModels.CustomerSearchItemViewModel
@using System.Linq

@{
    var initials = string.Join("", (Model?.Name ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(n => n[0]))
        .ToUpperInvariant();
    if (initials.Length > 2) initials = initials.Substring(0, 2);
}

<div class="customer-card" data-customer-json='@(Model?.ToJson() ?? "{}")'>
    <div class="customer-avatar">@initials</div>
    <div class="customer-info">
        <div class="customer-name"><i class="bi bi-person"></i> @Model?.Name &middot; <i class="bi bi-telephone"></i> @Model?.Phone</div>
    </div>
    <button class="customer-remove" onclick="removeCustomer()" title="Remove Customer">
        <i class="bi bi-x-lg"></i>
    </button>
</div>
