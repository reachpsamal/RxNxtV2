@model List<Rxnxt.Business.DTOs.StockDto>

@{
    ViewData["Title"] = "Stocks";
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container mt-4">
    <h2 class="mb-3">Stocks</h2>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning" role="alert">
            No Data Found
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Product Name</th>
                        <th>Manufacturer</th>
                        <th>Batch Number</th>
                        <th>Expiry Date</th>
                        <th class="text-end">MRP</th>
                        <th class="text-end">Available Qty</th>
                        <th>UOM</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isExpired = item.ExpiryDate.HasValue && item.ExpiryDate.Value.Date < DateTime.Today;
                        <tr class="@(isExpired ? "table-danger" : "")">
                            <td>@item.ProductName</td>
                            <td>@item.Manufacturer</td>
                            <td>@item.BatchNumber</td>
                            <td>@(item.ExpiryDate.HasValue ? item.ExpiryDate.Value.ToString("dd-MM-yyyy") : "")</td>
                            <td class="text-end">@item.Mrp</td>
                            <td class="text-end">@item.AvailableQty</td>
                            <td>@item.UomName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
